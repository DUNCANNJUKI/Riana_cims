# Shared MySQL database used by both CIMS and the Developers workspace
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=riana_cims
DATABASE_USER=riana_cims
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=30
DATABASE_POOL_IDLE=15

# API and authentication
VITE_API_PORT=8081
# Development-only override. Keep this relative to use the Vite proxy from
# localhost and other workstations on the LAN.
VITE_API_URL=/api
DEFAULT_PHONE_COUNTRY=KE
VITE_DEFAULT_PHONE_COUNTRY=KE
JWT_SECRET=replace-with-a-long-random-secret
CIMS_LOGIN_URL=https://rianacims.name.ng/
CORS_ALLOWED_ORIGINS=https://rianacims.name.ng

# Automatic backups (cron is interpreted in this timezone)
BACKUP_TIMEZONE=Africa/Nairobi
BACKUP_RETENTION_DAYS=30

# Email delivery (domain mailbox SMTP over implicit TLS)
SMTP_HOST=mail.rianacims.name.ng
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@rianacims.name.ng
SMTP_PASSWORD=replace-with-the-mailbox-password
# SMTP_PASS is accepted as a backward-compatible alias; configure only one password variable.
SMTP_FROM_EMAIL=info@rianacims.name.ng
SMTP_FROM_NAME=RIANA CIMS
# Alternatively: SMTP_FROM="RIANA CIMS <info@rianacims.name.ng>"
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=50
SMTP_RATE_LIMIT=5
SMTP_RETRY_ATTEMPTS=3
SMTP_RETRY_BASE_DELAY_MS=500

# SMS delivery (B-Textman)
B_TEXTMAN_API_KEY=replace-me
B_TEXTMAN_API_URL=https://your-b-textman-endpoint.example/functions/v1
B_TEXTMAN_SEND_PATH=send-sms
B_TEXTMAN_BALANCE_PATH=
SMS_SENDER_ID=RIANA
NOTIFICATION_PROVIDER_TIMEOUT_MS=10000
